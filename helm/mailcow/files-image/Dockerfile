# syntax=docker/dockerfile:1
# mailcow files image: data/web, data/conf, data/assets, data/hooks of one mailcow release.
# Every chart pod copies its slice into an emptyDir from this image (initContainer "seed"),
# the TLS bootstrap Job uses its openssl + curl, the rspamd controller socket relays and the external
# Redis TLS relay its socat, the cron scheduler (cronjobs.mode scheduler) busybox crond + kubectl.
#
# Build from the repository root with BuildKit (docker buildx), which picks up Dockerfile.dockerignore
# next to this file; the legacy builder ignores that file and would copy generated secrets:
#   docker buildx build -f helm/mailcow/files-image/Dockerfile \
#     --build-arg MAILCOW_VERSION=$(git describe --tags --abbrev=0) \
#     --build-arg MAILCOW_COMMIT=$(git rev-parse HEAD) \
#     -t <registry>/mailcow-files:<release> .
# Releases: build from a clean export (tracked files only), with any builder:
#   git archive HEAD | docker build -f helm/mailcow/files-image/Dockerfile -t <registry>/mailcow-files:<release> -
# kubectl for the cron scheduler; keep in line with the chart's cronjobs.image.tag
ARG KUBECTL_VERSION=v1.36.5
FROM registry.k8s.io/kubectl:${KUBECTL_VERSION} AS kubectl

FROM alpine:3.23

LABEL org.opencontainers.image.title="mailcow-files" \
      org.opencontainers.image.source="https://github.com/mailcow/mailcow-dockerized"

RUN apk add --no-cache openssl curl socat tzdata

COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl

# uid/gid 10900 of the chart's helper containers; named so busybox crond can run jobs as it
RUN addgroup -S -g 10900 mailcow && adduser -S -D -H -h /tmp -s /bin/sh -G mailcow -u 10900 mailcow

COPY data/web /mailcow/data/web
COPY data/conf /mailcow/data/conf
COPY data/assets /mailcow/data/assets
COPY data/hooks /mailcow/data/hooks

ARG MAILCOW_VERSION=dev
ARG MAILCOW_COMMIT=
ARG MAILCOW_BRANCH=master

# What generate_config.sh/update.sh write at install time, so the UI shows the release.
# Empty custom stylesheet php-fpm would otherwise create in its own copy only (nginx serves /web too).
RUN set -e; \
  printf '%s\n' '<?php' \
    "  \$MAILCOW_GIT_VERSION=\"${MAILCOW_VERSION}\";" \
    '  $MAILCOW_LAST_GIT_VERSION="";' \
    '  $MAILCOW_GIT_OWNER="mailcow";' \
    '  $MAILCOW_GIT_REPO="mailcow-dockerized";' \
    '  $MAILCOW_GIT_URL="https://github.com/mailcow/mailcow-dockerized";' \
    "  \$MAILCOW_GIT_COMMIT=\"${MAILCOW_COMMIT}\";" \
    '  $MAILCOW_GIT_COMMIT_DATE="";' \
    "  \$MAILCOW_BRANCH=\"${MAILCOW_BRANCH}\";" \
    "  \$MAILCOW_UPDATEDAT=$(date +%s);" \
    '?>' > /mailcow/data/web/inc/app_info.inc.php; \
  echo '/* Autogenerated by mailcow */' > /mailcow/data/web/css/build/0081-custom-mailcow.css; \
  mkdir -p /mailcow/data/web/templates/cache /mailcow/data/assets/ssl; \
  for h in dovecot phpfpm postfix rspamd sogo unbound; do mkdir -p /mailcow/data/hooks/$h; done; \
  test -s /mailcow/data/assets/ssl-example/dhparams.pem; \
  for f in conf/rspamd/override.d/worker-controller-password.inc conf/sogo/sieve.creds conf/sogo/cron.creds \
    conf/sogo/plist_ldap conf/phpfpm/sogo-sso/sogo-sso.pass conf/dovecot/dovecot-master.passwd \
    conf/acme/dns-01.conf assets/ssl/cert.pem assets/ssl/key.pem; do \
    if [ -e "/mailcow/data/$f" ]; then \
      echo "data/$f (generated/secret) is in the build context: build with BuildKit (Dockerfile.dockerignore) or from git archive" >&2; exit 1; \
    fi; \
  done

CMD ["/bin/sh"]
